rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só pode ler/escrever dentro do seu próprio documento
    // users/{uid}, incluindo todas as subcoleções (categories, projects,
    // e as subcoleções de cada projeto: tasks, notes, resources, files,
    // journal, activity).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
